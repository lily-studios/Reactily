{
  "name": "reactily-docs-react",
  "private": true,
  "version": "1.1.8",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist node_modules/.tmp",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "validate:api": "node scripts/validate-api-docs.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "npm run check:structure && npm run doctor && npm run typecheck && npm run validate:api && npm run build",
    "check:structure": "node scripts/check-structure.mjs"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.2",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
