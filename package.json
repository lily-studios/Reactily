
{
  "name": "reactily-luau",
  "version": "2.1.0",
  "description": "A strict Luau, React-inspired UI runtime for Roblox.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "generate:init": "node tools/generate-init.cjs",
    "generate:init:verbose": "node tools/generate-init.cjs --verbose",
    "generate:init:debug": "node tools/generate-init.cjs --debug",
    "preview:init": "node tools/generate-init.cjs --dry-run",
    "check:init": "node tools/generate-init.cjs --check",
    "verify:modules": "node tools/verify-reactily.cjs",
    "format": "stylua scripts",
    "format:check": "stylua --check scripts",
    "lint": "selene scripts",
    "sync": "npm run generate:init && npm run format",
    "check": "npm run check:init && npm run verify:modules && npm run format:check && npm run lint",
    "test": "npm run check",
    "build:release": "node tools/build-release.cjs",
    "build:release:clean": "node tools/build-release.cjs --clean",
    "build:release:xml": "node tools/build-release.cjs --format rbxmx",
    "release": "npm run check && npm run build:release:clean",
    "deploy": "npm run sync && npm run release"
  }
}
